<!-- Tarjeta de Bienvenida -->
<MudCard Class="mb-6" Style="background: linear-gradient(135deg, #00796B 0%, #004d40 100%); color: white; border-radius: 16px;">
    <MudCardContent Class="pa-6">
        <MudGrid Justify="Justify.Center">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h3" Class="mb-2" Style="font-weight: 600;">
                    ¡Bienvenido!
                </MudText>
                <MudText Typo="Typo.h5" Class="mb-2" Style="opacity: 0.9;">
                    @UserName
                </MudText>
                <MudText Typo="Typo.body1" Style="opacity: 0.8;">
                    Sistema de gestión de ordenes de trabajo para fincas.
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4" Class="text-center">
                <MudImage Src="logoMainMenu.png" Alt="logoFenix" Elevation="0" Class="rounded-lg" Style="height:180px; width:290px"/>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Módulos del Sistema -->
<MudText Typo="Typo.h4" Class="mb-4" Style="color: #00796B; font-weight: 500;">
        Módulos del Sistema
</MudText>

<MudGrid Spacing="4">
    <!-- Módulo Órdenes de Trabajo -->
    <ModuleComponent Link="ordenestrabajo"
                     Icon="@Icons.Material.Filled.Assignment"
                     Title="Órdenes de Trabajo"
                     SubTitle="Gestiona las órdenes de trabajo"/>
    <ModuleComponent Link="usuarios"
                     Icon="@Icons.Material.Filled.Person"
                     Title="Usuarios"
                     SubTitle="Gestión de usuarios y roles"/>
    <ModuleComponent Link="informes"
                     Icon="@Icons.Material.Filled.Add"
                     Title="Informes"
                     SubTitle="Consulta reportes y estadísticas"
                     ModuleDisabled=true/>
</MudGrid>
