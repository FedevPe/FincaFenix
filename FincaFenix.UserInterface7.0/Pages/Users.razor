@page "/usuarios"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TextAppBarStateService TextApp
@attribute [Authorize]

<AuthorizeView Roles="admin, desarrollador">
    <div class="mt-3 mb-3">
        <MudGrid Justify="Justify.FlexEnd" Class="mb-2 g-3">
            <MudItem>
                <MudButton Href="/nuevoUsuario" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd">
                    Nuevo Usuario
                </MudButton>
            </MudItem>
        </MudGrid>
    </div>
</AuthorizeView>

<div class="container-fluid shadow p-3 border rounded mt-3 mb-3 bg-color-white">
    <MudGrid Justify="Justify.FlexStart" Spacing="1">
        <MudItem>
            <MudText Typo="Typo.h5"><b>Gestión de Usuarios</b></MudText>
        </MudItem>
        <MudSpacer />
    </MudGrid>

    <MudDivider Class="my-2" Style="border-color: black;" />

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center" style="height: 200px;">
            <MudProgressCircular Color="Color.Primary" Style="height:70px;width:70px;" Indeterminate="true" />
            <MudText Typo="Typo.h6" Style="margin-top:30px">Cargando usuarios...</MudText>
        </div>
    }
    else
    {
        <UsersListComponent />
    }
</div>

@code {
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        TextApp.PageTitle = "Usuarios";
        await Task.Delay(100); // Simula carga inicial
        _isLoading = false;
        StateHasChanged();
    }
}

<style>
    /* Container Styles */
    .bg-color-white {
        background-color: white;
    }

    /* Empty State Styles */
    .empty-state-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 3rem 2rem;
        border: 1px solid #e2e8f0;
        margin: 1rem 0;
        transition: all 0.3s ease;
    }

    .empty-state-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1rem;
    }

    .empty-state-icon {
        font-size: 48px !important;
        color: #94a3b8 !important;
        opacity: 0.7;
        margin-bottom: 0.5rem;
    }

    .empty-state-title {
        color: #475569 !important;
        font-weight: 600 !important;
        margin: 0 !important;
    }

    .empty-state-description {
        color: #64748b !important;
        max-width: 400px !important;
        line-height: 1.6 !important;
        margin: 0 !important;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .empty-state-card

    {
        padding: 2rem 1.5rem;
    }

    .empty-state-icon {
        font-size: 40px !important;
    }

    .empty-state-description {
        max-width: 300px !important;
        font-size: 0.9rem !important;
    }

    }

    @@media (max-width: 480px) {
        .empty-state-card

    {
        padding: 1.5rem 1rem;
        margin: 0.5rem 0;
    }

    .empty-state-icon {
        font-size: 36px !important;
    }

    }
</style>
