@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IDialogService DialogService

<div class="modern-table-container">
    <MudTable T="ApplicationUser"
              Items="@userList"
              Hover="true"
              Breakpoint="Breakpoint.Sm"
              Dense="true"
              Class="modern-table"
              Elevation="0">

        <HeaderContent>
            <MudTh Class="modern-header">
                <div class="header-content">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="header-icon" />
                    <span>Nombre</span>
                </div>
            </MudTh>

            <MudTh Class="modern-header">
                <div class="header-content">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="header-icon" />
                    <span>Usuario</span>
                </div>
            </MudTh>

            <MudTh Class="modern-header">
                <div class="header-content">
                    <MudIcon Icon="@Icons.Material.Filled.Flag" Class="header-icon" />
                    <span>Rol</span>
                </div>
            </MudTh>

            <MudTh Class="modern-header">
                <div class="header-content">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="header-icon" />
                    <span>Acciones</span>
                </div>
            </MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd Class="modern-cell">
                <div class="user-name">
                    @context.Name @context.LastName
                </div>
            </MudTd>

            <MudTd Class="modern-cell">
                <div class="username-cell">
                    @context.UserName
                </div>
            </MudTd>

            <MudTd Class="modern-cell">
                @{
                    var role = userRoles.ContainsKey(context.Id)
                    ? userRoles[context.Id].FirstOrDefault()
                    : "Sin rol";
                }
                <MudChip T="string"
                         Class="role-chip"
                         Color="Color.Primary"
                         Size="Size.Small">
                    @role
                </MudChip>
            </MudTd>

            <MudTd Class="modern-cell">
                <div class="actions-container">
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="action-buttons">
                        <MudTooltip Text="Editar Usuario">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           Class="action-btn action-btn-secondary"
                                           OnClick="@(() => OpenEditUserDialog(context))" />
                        </MudTooltip>
                    </MudButtonGroup>
                </div>
            </MudTd>
        </RowTemplate>

    </MudTable>
</div>

@code {
    private List<ApplicationUser> userList = new();
    private Dictionary<string, List<string>> userRoles = new();
    private List<IdentityRole> availableRoles = new();

    protected override async Task OnInitializedAsync()
    {
        userList = UserManager.Users.ToList();
        availableRoles = RoleManager.Roles.ToList();

        foreach (var u in userList)
            userRoles[u.Id] = (await UserManager.GetRolesAsync(u)).ToList();
    }

    private async Task OpenEditUserDialog(ApplicationUser user)
    {
        var parameters = new DialogParameters
        {
            { "User", user },
            { "Roles", availableRoles },
            { "UserManager", UserManager },
            { "SignInManager", SignInManager }
        };

        var dialog = DialogService.Show<EditUserDialog>("Editar usuario", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
            StateHasChanged();
        }
    }
}

<style>
    /* Contenedor principal */
    .modern-table-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin: 1.5rem 0;
        border: 1px solid rgba(0, 0, 0, 0.06);
        animation: fadeIn 0.4s ease-out;
    }

    .modern-table {
        background: transparent !important;
    }

    /* Encabezados de tabla */
    .modern-header {
        background: #00796B;
        color: white !important;
        font-weight: 600 !important;
        padding: 1rem 1.25rem !important;
        border: none !important;
        position: relative;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

        .modern-header::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, rgba(255,255,255,0.4), rgba(255,255,255,0.1), rgba(255,255,255,0.4));
        }

    .header-content {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
    }

    .header-icon {
        font-size: 18px !important;
        opacity: 0.95;
    }

    /* Celdas de datos */
    .modern-cell {
        border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important;
        vertical-align: middle !important;
        background: white;
        transition: all 0.2s ease;
        font-size: 0.95rem;
    }

    .modern-table tbody tr:hover .modern-cell {
        background: #f8fafb;
        transform: scale(1.002);
    }

    /* Estilos específicos por columna */
    .user-name {
        font-weight: 500;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .username-cell {
        color: #64748b;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.9rem;
    }

    .role-chip {
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(0, 121, 107, 0.2);
        border: 1px solid rgba(0, 121, 107, 0.3);
    }

    /* Contenedor de acciones - Estilo del componente guía */
    .actions-container {
        display: flex;
        justify-content: center;
    }

    .action-buttons {
        box-shadow: none;
    }

    .action-btn {
        border: 1px solid rgba(0, 0, 0, 0.12) !important;
        transition: all 0.2s ease !important;
        background: white !important;
    }

        .action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15) !important;
        }

    .action-btn-secondary:hover {
        background: rgba(156, 39, 176, 0.04) !important;
    }

    .action-btn-info:hover {
        background: rgba(33, 150, 243, 0.04) !important;
    }

    .action-btn-error:hover {
        background: rgba(244, 67, 54, 0.04) !important;
    }

    /* Animaciones */
    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .modern-table tbody tr {
        animation: fadeInUp 0.3s ease-out;
    }

        .modern-table tbody tr:nth-child(even) {
            animation-delay: 0.05s;
        }

        .modern-table tbody tr:nth-child(odd) {
            animation-delay: 0.1s;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .modern-table-container

    {
        border-radius: 12px;
        margin: 1rem 0;
    }

    .modern-header,
    .modern-cell {
        padding: 0.75rem 0.85rem !important;
        font-size: 0.85rem;
    }

    .header-content {
        gap: 0.35rem;
    }

    .header-icon {
        font-size: 16px !important;
    }

    .user-name,
    .username-cell {
        font-size: 0.85rem;
    }

    }

    @@media (max-width: 480px) {
        .modern-header

    {
        font-size: 0.75rem;
        padding: 0.65rem 0.75rem !important;
    }

    .modern-cell {
        padding: 0.85rem 0.75rem !important;
    }

    .header-content {
        flex-direction: column;
        gap: 0.2rem;
        text-align: center;
    }

    .role-chip {
        font-size: 0.75rem;
    }

    .action-buttons {
        flex-direction: column;
        gap: 0.25rem;
    }

    }
</style>